# Copy to .env and fill in. Never commit real keys.
FRAUD_MODEL_PROVIDER=scripted        # scripted | cloudflare | gemini | replay
GEMINI_API_KEY=
FRAUD_TRACING=0                      # 1 exports traces to Phoenix at http://localhost:6006
# Cloudflare Workers AI (FRAUD_MODEL_PROVIDER=cloudflare); token needs the Workers AI permission
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/deepseek-ai/deepseek-v4.1-flash-1017
